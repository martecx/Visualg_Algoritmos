Algoritmo "alg.04"
// Função: Ler dois números e mostrar a soma 
// Autor: Mariela Nogueira
// Data: 05/09/2025
Var
  N1, N2, S: inteiro
Inicio
    Escreva ("Digite um número: ")
    Leia (N1)
    Escreva ("Digite outro número: ")
    Leia (N2)
    S <- N1 + N2 
    Escreva (" A soma entre ", N1, " e ", N2, " é igual a ", S)
Fimalgoritmo
