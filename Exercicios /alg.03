Algoritmo "alg.03"
  //Função: Ler nome e salario
  //Autor: Mariela Nogueira
  //Data: 28/08/2025
Var
  nome: caractere
  salario: real
Inicio
   Escreva ("Nome do Funcionário: ")
   Leia (nome)
   Escreva ("Salário: ")
   Leia (salario)
   Escreval ("O funcionário ", nome ,"tem um salário de R$", salario,")
Fimalgoritmo
